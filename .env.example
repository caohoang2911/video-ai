# === AI Operator — environment template ===
# Copy to .env and fill real values. NEVER commit .env.

# --- Content (phase 02) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                 # optional fallback

# --- TTS (phase 03) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=            # chosen narration voice (BBC-style deep male)
OPENAI_API_KEY=                 # optional: OpenAI TTS-1 fallback

# --- Visuals (phase 03) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
FAL_KEY=                        # fal.ai key — REQUIRED when IMAGE_GEN_BACKEND=fal_flux (the default)
# Generator for the still tier (maps/illustrations/stock misses):
#   fal_flux (default) = fal.ai FLUX.1-dev first (~$0.025/image, commercial output OK), SDXL offline fallback
#   sdxl               = local SDXL first (free, fully offline) — rollback / no-network
IMAGE_GEN_BACKEND=fal_flux
# Thumbnail hero enhancement: relight the primary (archival) thumbnail through FLUX Kontext —
# subject-preserving, ~$0.04/video. Set false for PIL-grade only (no fal call, $0).
THUMBNAIL_KONTEXT_ENHANCE=true
# Min CLIP relevance (subject vs archival photo) to let a real photo face the video; below it
# the hero falls back to a synthetic FLUX drama frame. 0.20-0.30 typical; raise to be stricter.
THUMB_RELEVANCE_MIN=0.22

# --- YouTube publisher (phase 06) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=               # from `operator authorize` (run once)
YT_CHANNEL_ID=

# --- Review gate (phase 05) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=               # from `operator get-chat-id`

# --- Infra / guardrails (phase 01) ---
DB_URL=sqlite:///data/operator.db
MONTHLY_BUDGET=500              # hard cap (USD) — pipeline refuses API calls past this
LOG_LEVEL=INFO

# --- Channel config (phase 02/06) ---
NICHE=Forgotten Maritime Disasters
YT_CATEGORY_ID=27              # 27 = Education
WEEKLY_VIDEO_CAP=3            # throttle: max uploads / 7 days

# Khoá nguồn visual theo tên (phẩy ngăn cách: pixabay,pexels,wikimedia) mà không cần xoá API key
DISABLED_VISUAL_SOURCES=

# Quota ký tự/tháng của gói ElevenLabs THẬT (xem dashboard "credits"; Creator=100000, Starter=40000)
ELEVENLABS_MONTHLY_CHAR_QUOTA=100000
